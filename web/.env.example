# Leave VITE_API_URL empty to run on the built-in fake data layer (demo mode).
VITE_API_URL=http://localhost:3000
# Optional: base URL of find_similiar_users (Suggested friends). Empty uses the main API's /users/:id/similar.
VITE_SIMILAR_URL=http://localhost:3001
# YouTube id of an admin-registered watch-to-earn video (PUT /admin/videos). Empty hides the player.
VITE_WATCH_VIDEO_ID=
# Twitch service (replays + watch points). Leave empty to use VITE_API_URL.
VITE_TWITCH_URL=http://localhost:3500
