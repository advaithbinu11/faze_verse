PORT=3000
NODE_ENV=development

# MongoDB Atlas (transactions require a replica set, which Atlas provides)
# MONGO_DB_URL is accepted as an alias for MONGODB_URI.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# The database name is literal, including the trailing semicolon.
MONGODB_DB=faze_platform;
MONGODB_MAX_POOL=50
MONGODB_MIN_POOL=5

# Auth
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL=7d
# Public URL of THIS API (used as the Steam OpenID realm / return_to)
API_BASE_URL=http://localhost:3000
# Frontend that receives the login redirect (token is passed in the URL fragment)
FRONTEND_URL=http://localhost:5173
# Extra comma-separated browser origins allowed by CORS (e.g. a LAN address or preview port).
# Development already allows the 127.0.0.1 twin of FRONTEND_URL.
CORS_ORIGINS=
# Comma-separated SteamID64s granted the admin role at login
ADMIN_STEAM_IDS=

# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Points economy
SIGNUP_BONUS_POINTS=1000
MAX_PREDICTION_POINTS=100000
WATCH_MIN_RATIO=0.9
PARTY_MAX_SIZE=5

# Discord (optional; reminders are disabled without a bot token)
DISCORD_BOT_TOKEN=
# Discord OAuth2 app for "Link Discord" (developer portal > OAuth2). Add API_BASE_URL/auth/discord/callback as a redirect.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_ANNOUNCE_CHANNEL_ID=
DISCORD_PING_ROLE_ID=
EVENT_REMINDER_MINUTES=30

# Set to 1 to run the HTTP API without the payout/Discord background workers
DISABLE_WORKERS=0

# Faker service that creates a Discord voice channel per party (its API_KEY goes in the key).
# Run Faker on a different PORT than this API. Leave unset to skip Discord channels.
DISCORD_PARTY_SERVICE_URL=http://localhost:3100
DISCORD_PARTY_SERVICE_KEY=

# Twitch app (https://dev.twitch.tv/console, category "Website Integration"). Lets the Live page replay a channel's latest
# past broadcast while it is offline. Leave empty to skip replays. Watch points need no Twitch credentials.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_DAILY_POINT_CAP=1000
# Port of the Twitch service (npm run twitch). The web app reaches it through VITE_TWITCH_URL.
TWITCH_PORT=3500
